@base = http://localhost:8847
@cookie = fs-admin-dev=REPLACE_WITH_CURRENT_SESSION
@notifications = {{base}}/api/v1/notifications
@channelId = 00000000-0000-0000-0000-000000000000
@deliveryId = 00000000-0000-0000-0000-000000000000

### List channels
GET {{notifications}}/channels?limit=50
Cookie: {{cookie}}

### Create Telegram channel
POST {{notifications}}/channels
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"name":"Telegram ops","kind":"telegram","enabled":true,"telegram":{"chatId":"-1001234567890","botToken":"REPLACE_WITH_TOKEN","silent":true}}

### Create Bark channel
POST {{notifications}}/channels
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"name":"Phone","kind":"bark","enabled":true,"bark":{"deviceKey":"REPLACE_WITH_KEY","group":"FileSharing","sound":"bell"}}

### Read a channel
GET {{notifications}}/channels/{{channelId}}
Cookie: {{cookie}}

### Update a channel and keep its token
PUT {{notifications}}/channels/{{channelId}}
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"name":"Telegram ops","kind":"telegram","enabled":true,"revision":1,"telegram":{"chatId":"-1001234567890","messageThreadId":71,"silent":true}}

### Verify the Telegram bot and chat
POST {{notifications}}/channels/{{channelId}}/verify
Origin: {{base}}
Cookie: {{cookie}}

### Queue an actual test message. Change the idempotency key for another send.
POST {{notifications}}/channels/{{channelId}}/test
Origin: {{base}}
Cookie: {{cookie}}
Idempotency-Key: filesharing-test-01
Content-Type: application/json

{"title":"FileSharing test","body":"Check that this notification reached the configured destination."}

### Read a delivery
GET {{notifications}}/deliveries/{{deliveryId}}
Cookie: {{cookie}}

### Filter and page deliveries
GET {{notifications}}/deliveries?channelId={{channelId}}&after=0&limit=50
Cookie: {{cookie}}

### Replay notification updates
GET {{notifications}}/updates?after=0&limit=50
Cookie: {{cookie}}

### Delete a channel
DELETE {{notifications}}/channels/{{channelId}}?revision=2
Origin: {{base}}
Cookie: {{cookie}}

@deviceId = 00000000-0000-0000-0000-000000000000
@ruleId = 00000000-0000-0000-0000-000000000000

### Discover event types, filters and variables
GET {{notifications}}/event-types
Cookie: {{cookie}}

### List enabled rules for a device
GET {{notifications}}/rules?deviceId={{deviceId}}&enabled=true&limit=50
Cookie: {{cookie}}

### Create a rule for more than one event
POST {{notifications}}/rules
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"name":"Lid changes","deviceId":"{{deviceId}}","channelIds":["{{channelId}}"],"enabled":true,"events":["lid.closed","lid.opened"],"template":{"title":"\u007b\u007bdevice.name\u007d\u007d","body":"\u007b\u007bevent.type\u007d\u007d at \u007b\u007bevent.occurredAt\u007d\u007d"}}

### Get a rule and its counters
GET {{notifications}}/rules/{{ruleId}}
Cookie: {{cookie}}

### Edit a rule
PUT {{notifications}}/rules/{{ruleId}}
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"name":"Lid changes","deviceId":"{{deviceId}}","channelIds":["{{channelId}}"],"enabled":false,"revision":1,"events":["lid.closed","lid.opened"],"template":{"title":"\u007b\u007bdevice.name\u007d\u007d","body":"\u007b\u007bevent.type\u007d\u007d"}}

### Preview a template
POST {{notifications}}/rules/preview
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"event":"lid.closed","template":{"title":"\u007b\u007bdevice.name\u007d\u007d","body":"Closed at \u007b\u007bevent.occurredAt\u007d\u007d"},"context":{"device.name":"Desk Mac","lid.closed":"true"}}

### Delete a rule
DELETE {{notifications}}/rules/{{ruleId}}?revision=2
Origin: {{base}}
Cookie: {{cookie}}

@rootId = 00000000-0000-0000-0000-000000000000

### Watch PDF changes in an authorized directory
POST {{notifications}}/rules
Origin: {{base}}
Cookie: {{cookie}}
Content-Type: application/json

{"name":"PDF changes","deviceId":"{{deviceId}}","enabled":true,"events":["file.added","file.removed","file.renamed","file.modified"],"channelIds":["{{channelId}}"],"filter":{"file":{"rootId":"{{rootId}}","path":"Documents/Reports","nameGlob":"*.pdf","entryKind":"file"}},"template":{"title":"\u007b\u007bdevice.name\u007d\u007d reports","body":"\u007b\u007bevent.type\u007d\u007d: \u007b\u007bfile.path\u007d\u007d"}}

### List active and waiting notification directory watches
GET {{notifications}}/watches?deviceId={{deviceId}}
Cookie: {{cookie}}
