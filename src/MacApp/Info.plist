<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>FileSharingService</string>
    <key>CFBundleName</key>
    <string>FileSharingService</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSUIElement</key>
    <true/>
    <key>FileSharingOrigin</key>
    <string>$(FILESHARING_ORIGIN)</string>
    <key>FileSharingBackupOrigin</key>
    <string>$(FILESHARING_BACKUP_ORIGIN)</string>
    <key>FileSharingManagedUser</key>
    <string>$(FILESHARING_MANAGED_USER)</string>
    <key>FileSharingHomeWritable</key>
    <string>$(FILESHARING_ALLOW_HOME_WRITE)</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>FileSharingService 请求访问桌面，以便在你授权后浏览此目录。</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>FileSharingService 请求访问文稿，以便在你授权后浏览此目录。</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>FileSharingService 请求访问下载，以便在你授权后浏览此目录。</string>
</dict>
</plist>
